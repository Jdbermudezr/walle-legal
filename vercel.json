{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(atajo|applepay|gmail)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).shortcut",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/atajo",
      "destination": "/applepay",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/activar",
      "destination": "https://fnolzmacqnaxcktlxhxx.supabase.co/functions/v1/google-oauth-start"
    },
    {
      "source": "/oauth/callback",
      "destination": "https://fnolzmacqnaxcktlxhxx.supabase.co/functions/v1/google-oauth-callback"
    }
  ]
}
